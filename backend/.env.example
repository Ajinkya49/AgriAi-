# ---------------------------------------------------------------------------
# Agri AI — backend environment variables
# Copy to `.env` and fill in real values.  Never commit `.env`.
# Variable names follow the "Environment Variables" section of 02-TRD-AgriAI.md.
# ---------------------------------------------------------------------------

# ---- App ----
ENVIRONMENT=development
API_PREFIX=/api
# Comma-separated browser origins allowed to call this API.
# Include BOTH localhost and 127.0.0.1 — they are different origins to a browser,
# and a page served from one cannot call an API that only allows the other.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Supabase (Auth + Postgres + Storage) ----
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agri-ai

# Postgres connection string (Project Settings -> Database -> Connection string).
# Used by migration/seeding scripts and the Supabase Python client.
DATABASE_URL=

# ---- Disease detection model (Phase 4) ----
# Path to the fine-tuned EfficientNet-B0 weights, relative to backend/.
MODEL_PATH=app/models/weights/efficientnet_b0_agri.pt
MODEL_VERSION=v1.0.0

# ---- RAG assistant (Phase 6) ----
# Path to the persisted FAISS index, relative to backend/.
FAISS_INDEX_PATH=app/rag/index/knowledge_base.faiss
# --- Conversational LLM ---
# OpenRouter is the primary chat provider; Gemini is the fallback. Both are
# conversation-only. Embeddings always use Gemini, because the FAISS index was
# built with gemini-embedding-001.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free

GEMINI_API_KEY=
# Verified against this project's key. `gemini-2.5-flash` is retired for new
# accounts (404) and `gemini-flash-latest` intermittently 503s.
GEMINI_MODEL=gemini-3.6-flash
# Changing this invalidates the FAISS index — rebuild it with
# `python scripts/build_faiss_index.py`. Vectors from different models are not
# comparable, and `app/rag/index.py` refuses to load a mismatch.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Tried in order when the primary model returns 429/503. The free tier allows only
# 20 requests/day/model, and the chain shares that ceiling.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview

# ---- Retrieval ----
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# ---- Weather advisory (IMD) ----
# Register at https://api.imd.gov.in/, subscribe to the "City Weather Forecast
# (7 Days)" product, and paste the key. Without it the /weather page reports
# "weather is not available" — the rest of the app is unaffected.
IMD_API_KEY=

# ===========================================================================
# PRODUCTION
# ===========================================================================
# Set ENVIRONMENT=production and the app will check this file's contents at
# startup, logging every problem it finds and reporting them from
# GET /api/health/dependencies as `config_problems`.
#
# Two things it specifically catches, because both fail silently in the browser:
#   * CORS_ORIGINS still pointing at localhost
#   * CORS_ORIGINS missing the deployed frontend origin
#
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-app.vercel.app
